{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverse:schema:save:0.1.0",
  "title": "OpenVerse save file v0.1.0",
  "description": "Normative schema for a save. A save is self-contained: item_defs embeds a snapshot of every held item's definition so that a save survives its defining world package being unpublished, renamed or deleted. See SPEC.md section 8.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["save_version", "created_at", "updated_at", "player", "inventory", "item_defs"],
  "properties": {
    "save_version": { "$ref": "#/$defs/semver" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_world", "at"],
      "properties": {
        "current_world": { "$ref": "#/$defs/slug" },
        "at": { "$ref": "#/$defs/coord" },
        "props": { "$ref": "#/$defs/props" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stacks"],
      "properties": {
        "stacks": {
          "type": "array",
          "maxItems": 4096,
          "description": "Ordered: this is the player's slot order and must be preserved. Two stacks may share an item id (a split stack) and must not be silently merged.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "count"],
            "properties": {
              "item": { "$ref": "#/$defs/itemId" },
              "count": { "type": "integer", "minimum": 1, "maximum": 9999 },
              "props": { "$ref": "#/$defs/props" }
            }
          }
        }
      }
    },
    "item_defs": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": { "$ref": "#/$defs/itemId" },
      "additionalProperties": { "$ref": "#/$defs/itemDef" }
    },
    "world_state": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consumed_pickups": {
            "type": "array",
            "maxItems": 10000,
            "items": { "$ref": "#/$defs/slug" }
          },
          "props": { "$ref": "#/$defs/props" }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "RFC 3339, UTC, second precision."
    },
    "slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]([a-z0-9_]*[a-z0-9])?$" },
    "itemId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 129,
      "pattern": "^[a-z0-9]([a-z0-9_]*[a-z0-9])?:[a-z0-9]([a-z0-9_]*[a-z0-9])?$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "resourcePath": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_\\-./]*$" },
    "color": { "type": "string", "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$" },
    "coord": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": -100000, "maximum": 100000 }
    },
    "props": { "type": "object" },
    "itemDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "icon"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "display_name": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["color"], "not": { "required": ["texture"] } },
            { "required": ["texture"], "not": { "required": ["color"] } }
          ],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "texture": { "$ref": "#/$defs/resourcePath" }
          }
        },
        "stack_limit": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "props": { "$ref": "#/$defs/props" }
      }
    }
  }
}
